    \title<SCP-055>
  >
  \body<

    \header|class="header"|<
      \div|class="header-inner"|<
        \div|class="title"|<
          \div|class="title-main"|<Ловгудоо SCP>
          \div|class="title-catch"|<
            \span|class="nowrap"|<Возицла · Севсихла · Дазула>
            \span|class="nowrap"|<— Лозуннако Лофинно>
